# Copie pra .env antes do `docker compose up`: cp .env.docker.example .env
# (gere segredos com: openssl rand -hex 24)

# Senha do banco PostgreSQL (vai pro container só, não expõe porta)
POSTGRES_SENHA=mude-esta-senha-do-banco-artrip

# Segredo de assinatura dos JWT (troque!)
JWT_SECRET=troque-por-um-segredo-forte-artrip-demo

# Porta pública do site (o nginx; o cloudflared tunela nela)
PORTA=8093

# --- Chaves opcionais (sem elas o fluxo usa fallback local, pensado pra demo) ---
CLAUDE_API_KEY=
OPENAI_API_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=